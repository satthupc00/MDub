{
  "manifest_version": 3,
  "name": "MDub — Thuyết minh YouTube",
  "short_name": "MDub",
  "version": "1.0.0",
  "description": "Đọc thuyết minh tiếng Việt cho video YouTube (cần app MDub chạy trên máy). Created by Mondiro.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "MDub", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.youtube.com/*"],
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["hook.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [{ "resources": ["icons/32.png", "icons/48.png"], "matches": ["https://www.youtube.com/*"] }]
}
